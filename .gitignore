.DS_Store
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
.uv/
catboost_info/

# Raw data (downloaded by scripts at runtime)
data/*
!data/.gitkeep
!data/README.md

# Embeddings (regenerated by CoLES baselines)
embeddings/**/*.npy
embeddings/**/*.npz

# Experiment outputs — keep result.json + .gitkeep, ignore large binaries
results/**/*.pt
results/**/*.npy
results/**/*.npz
results/**/checkpoints/
results/**/ft_runs/
results/**/llm4es_lora/

# Run logs
logs/*.log
logs/*.out
logs/*.err
